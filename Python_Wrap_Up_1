class Guild:
    def __init__(self, name):
        self.name = name
        # Guild SHOULD NOT inherit from Character.
        # A Guild HAS members (composition).
        self.members = []

    def add_member(self, character):
        # TODO:
        # - add the character to members list
        self.members.append(character)

    def perform_actions(self):
        for member in self.members:
            member.action()
