class Character:
    def __init__(self, name, max_stamina):
        self.name = name
        self._max_stamina = max_stamina
        self.set_stamina(max_stamina)
        self._stamina = self._stamina 
        # TODO:
        # - store name
        # - store max_stamina
        # - start current stamina full (== max_stamina)
        # - use the setter to enforce validation

    def get_stamina(self):
        return self._stamina

    def get_max_stamina(self):
        return self._max_stamina

    def set_stamina(self, value):
        if value < 0 or value > self._max_stamina:
            raise ValueError("Invalid stamina value")
        self._stamina = value
        
        # TODO:
        # - value must be between 0 and max_stamina (inclusive)
        # - if not, raise ValueError("Invalid stamina value")
        # - otherwise, set self._stamina
        #
        # Remember to repeat the variable on both sides:
        # value < 0 or value > self._max_stamina

    def action(self):
        # Base version: can stay simple or even empty
        # Subclasses will override this
        print(f"{self._name} does something...")

    def __str__(self):
        return f"{self.name} (STA: {self._stamina}/{self._max_stamina})"
        # TODO: return EXACTLY this format:
        # "<name> (STA: <current>/<max>)"
        #
        # Example: "Thorin (STA: 30/50)"


